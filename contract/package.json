{
  "name": "@licensed/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Erick Romero (https://x.com/ErickRomeroEdda)",
  "description": "LicenseRegistry Compact contract: revocable, privacy-preserving professional-license credentials on did:midnight",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./managed/*": "./dist/managed/*"
  },
  "files": ["dist"],
  "scripts": {
    "compact": "compact compile +0.31.1 src/license-registry.compact src/managed/license-registry",
    "prebuild": "test -d src/managed/license-registry || pnpm run compact",
    "build": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/managed && cp -R src/managed/license-registry dist/managed/",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-did-jubjub-schnorr": "0.5.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "4.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
